# --- MQTT BROKER (EMQX CLOUD PRIVATE - TLS 8883 / WSS 8084) ---
MQTT_HOST=your_cluster_id.ala.asia-southeast1.emqxsl.com
MQTT_TCP_PORT=8883
MQTT_WS_PORT=8084
MQTT_WS_PATH=/mqtt
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# --- MQTT TOPIC PREFIX ---
MQTT_TOPIC_PREFIX=nhom2_quanhoicanh/farm/pond_01

# --- ESP32 WI-FI CREDENTIALS ---
WIFI_SSID=Wokwi-GUEST
WIFI_PASSWORD=
