# 1. Các file chứa mật khẩu, khóa bí mật & cấu hình cục bộ (Local Credentials)
.env
.env.local
.env.*.local
include/secrets.h
web/config.js

# Cho phép giữ lại các file mẫu template để hướng dẫn người dùng clone
!.env.example
!include/secrets.example.h
!web/config.example.js

# 2. Thư mục biên dịch PlatformIO
.pio
.pioenvs
.piolibdeps

