.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/
*.swp
*~

# 4. Hệ điều hành
Thumbs.db
Desktop.ini
.DS_Store
